# Supabase Configuration
# Get these from your Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL
NEXT_PUBLIC_APP_URL=https://app.bitxbit.com.au

# OAuth providers (configured in Supabase Auth > Providers)
# No local keys required — client IDs and secrets live in Supabase.

# Solana Token Distribution
# SPL token mint address for bitxbit
BITXBIT_TOKEN_MINT=DK6PWMyuZ4NMjsm9AWNCTMKrajQYrtfMjMJ3QauX2UH5
# Token decimals (usually 6 or 9)
BITXBIT_TOKEN_DECIMALS=9
# Private key of the affiliate airdrop wallet (base58 encoded Solana keypair)
# SECURITY: Keep this secret. Rotate immediately if compromised.
AIRDROP_WALLET_PRIVATE_KEY=your-base58-private-key

# Birdeye API key (primary source for price, liquidity, market cap, holders)
# Get one at: https://birdeye.so/
BIRDEYE_API_KEY=your-birdeye-api-key

# Security notifications (R-021)
# API key for transactional email (the provider already sends bitXbit's auth email).
# WITHOUT this key the wallet sign-in alert is NOT SENT — the sign-in still works, and
# the outcome is recorded as `not_configured` in security_audit_log, so the gap is
# visible rather than silent. Required in production, preview and branch-deploy contexts.
RESEND_API_KEY=your-transactional-email-api-key
# Optional override for the From header. Must be a domain verified with the provider.
# SECURITY_NOTIFICATION_FROM="bitXbit Security <hello@bitxbit.com.au>"
