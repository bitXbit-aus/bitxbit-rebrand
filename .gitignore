.env*.bak*
.env.*.bak*
!dashboard-app/.env.local.example

# TypeScript incremental build info
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# OS files
.DS_Store
Thumbs.db

# IDE / editors
.vscode/
.idea/
*.swp
*.swo
*~

# Misc
.cache/
.vercel
.netlify
*.patch
dashboard-app/supabase/.temp/

# compiled test/harness output (tsc --outDir targets; never commit)
.test-dist/
.staging-dist/

# Playwright browser-smoke output (never commit)
dashboard-app/test-results/
dashboard-app/playwright-report/
dashboard-app/blob-report/
dashboard-app/.playwright/
